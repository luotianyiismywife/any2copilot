{
	"name": "any2copilot",
	"publisher": "luotianyiismywife",
	"displayName": "Copilot Provider Scaffold",
	"description": "A VS Code extension scaffold for integrating any three-protocol-compatible platform (OpenAI / Anthropic / Responses) into GitHub Copilot Chat. Fill in your platform details per PLATFORM_PORTING.md.",
	"keywords": [
		"ai",
		"chat",
		"copilot",
		"github-copilot",
		"language-models",
		"llm",
		"openai-compatible",
		"scaffold",
		"template",
		"thinking",
		"git-commit"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/luotianyiismywife/any2copilot"
	},
	"homepage": "https://github.com/luotianyiismywife/any2copilot",
	"bugs": {
		"url": "https://github.com/luotianyiismywife/any2copilot/issues"
	},
	"version": "1.0.0",
	"engines": {
		"vscode": "^1.116.0"
	},
	"categories": [
		"AI",
		"Chat"
	],
	"license": "AGPL-3.0",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "any2copilot",
				"displayName": "%providerDisplayName%",
				"managementCommand": "any2copilot.setApiKey"
			}
		],
		"commands": [
			{
				"command": "any2copilot.setApiKey",
				"category": "%commandCategory%",
				"title": "%command.setApiKey%"
			},
			{
				"command": "any2copilot.getApiKey",
				"category": "%commandCategory%",
				"title": "%command.getApiKey%"
			},
			{
				"command": "any2copilot.openSettings",
				"category": "%commandCategory%",
				"title": "%command.openSettings%"
			},
			{
				"command": "any2copilot.generateGitCommitMessage",
				"title": "%command.generateCommit%",
				"category": "%commandCategory%",
				"icon": "$(wand)"
			},
			{
				"command": "any2copilot.abortGitCommitMessage",
				"title": "%command.abortCommit%",
				"category": "%commandCategory%",
				"icon": "$(debug-stop)"
			},
			{
				"command": "any2copilot.setModelPreset",
				"category": "%commandCategory%",
				"title": "%command.setModelPreset%"
			},
			{
				"command": "any2copilot.manageApiKeys",
				"category": "%commandCategory%",
				"title": "%command.manageApiKeys%"
			},
			{
				"command": "any2copilot.setVisionProxyModel",
				"category": "%commandCategory%",
				"title": "%command.setVisionProxyModel%"
			},
			{
				"command": "any2copilot.syncPush",
				"category": "%commandCategory%",
				"title": "%command.syncPush%"
			},
			{
				"command": "any2copilot.syncPull",
				"category": "%commandCategory%",
				"title": "%command.syncPull%"
			},
			{
				"command": "any2copilot.checkUsage",
				"category": "%commandCategory%",
				"title": "%command.checkUsage%"
			}
		],
		"walkthroughs": [
			{
				"id": "copilotProviderGettingStarted",
				"title": "%walkthrough.title%",
				"description": "%walkthrough.description%",
				"steps": [
					{
						"id": "setApiKey",
						"title": "%walkthrough.setApiKey.title%",
						"description": "%walkthrough.setApiKey.description%",
						"media": {
							"markdown": "resources/walkthrough/set-api-key.md"
						},
						"completionEvents": [
							"onCommand:any2copilot.setApiKey"
						]
					},
					{
						"id": "showModels",
						"title": "%walkthrough.showModels.title%",
						"description": "%walkthrough.showModels.description%",
						"media": {
							"markdown": "resources/walkthrough/show-models.md"
						}
					},
					{
						"id": "advancedSettings",
						"title": "%walkthrough.advancedSettings.title%",
						"description": "%walkthrough.advancedSettings.description%",
						"media": {
							"markdown": "resources/walkthrough/advanced-settings.md"
						}
					}
				]
			}
		],
		"menus": {
			"scm/title": [
				{
					"command": "any2copilot.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !any2copilot.isGeneratingCommit"
				},
				{
					"command": "any2copilot.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && any2copilot.isGeneratingCommit"
				}
			],
			"commandPalette": [
				{
					"command": "any2copilot.generateGitCommitMessage",
					"when": "config.git.enabled && !any2copilot.isGeneratingCommit"
				},
				{
					"command": "any2copilot.abortGitCommitMessage",
					"when": "config.git.enabled && any2copilot.isGeneratingCommit"
				}
			]
		},
		"configuration": {
			"title": "%config.title%",
			"properties": {
				"any2copilot.commitLanguage": {
					"type": "string",
					"default": "auto",
					"enum": [
						"auto",
						"English",
						"French",
						"Italian",
						"German",
						"Spanish",
						"Russian",
						"Chinese (Simplified)",
						"Chinese (Traditional)",
						"Japanese",
						"Korean",
						"Czech",
						"Portuguese (Brazil)",
						"Turkish",
						"Polish"
					],
					"enumDescriptions": [
						"%config.commitLanguage.auto.desc%",
						"%config.commitLanguage.enum.English.desc%",
						"%config.commitLanguage.enum.French.desc%",
						"%config.commitLanguage.enum.Italian.desc%",
						"%config.commitLanguage.enum.German.desc%",
						"%config.commitLanguage.enum.Spanish.desc%",
						"%config.commitLanguage.enum.Russian.desc%",
						"%config.commitLanguage.enum.ChineseSimplified.desc%",
						"%config.commitLanguage.enum.ChineseTraditional.desc%",
						"%config.commitLanguage.enum.Japanese.desc%",
						"%config.commitLanguage.enum.Korean.desc%",
						"%config.commitLanguage.enum.Czech.desc%",
						"%config.commitLanguage.enum.PortugueseBrazil.desc%",
						"%config.commitLanguage.enum.Turkish.desc%",
						"%config.commitLanguage.enum.Polish.desc%"
					],
					"description": "%config.commitLanguage.desc%"
				},
				"any2copilot.commitModel": {
					"type": "string",
					"default": "example-model",
					"description": "%config.commitModel.desc%"
				},
				"any2copilot.commitMessagePrompt": {
					"type": "string",
					"default": "",
					"description": "%config.commitMessagePrompt.desc%"
				},
				"any2copilot.requestTimeout": {
					"type": "number",
					"default": 600000,
					"minimum": 10000,
					"description": "%config.requestTimeout.desc%"
				},
				"any2copilot.recentCommitsCount": {
					"type": "number",
					"default": 10,
					"minimum": 0,
					"maximum": 50,
					"description": "%config.recentCommitsCount.desc%"
				},
				"any2copilot.commitIncludeCommitDiff": {
					"type": "boolean",
					"default": false,
					"description": "%config.commitIncludeCommitDiff.desc%"
				},
				"any2copilot.commitAttachContextFiles": {
					"type": "boolean",
					"default": true,
					"description": "%config.commitAttachContextFiles.desc%"
				},
				"any2copilot.modelPreset": {
					"type": "string",
					"default": "custom",
					"description": "%config.modelPreset.desc%",
					"editPresentation": "singlelineText"
				},
				"any2copilot.temperature": {
					"type": "number",
					"default": 1,
					"minimum": 0,
					"maximum": 2,
					"description": "%config.temperature.desc%"
				},
				"any2copilot.top_p": {
					"type": "number",
					"default": 0.5,
					"minimum": 0,
					"maximum": 1,
					"description": "%config.top_p.desc%"
				},
				"any2copilot.enableAutoModelDiscovery": {
					"type": "boolean",
					"default": true,
					"description": "%config.enableAutoModelDiscovery.desc%"
				},
				"any2copilot.syncModelsOnStartup": {
					"type": "boolean",
					"default": true,
					"description": "%config.syncModelsOnStartup.desc%"
				},
				"any2copilot.maxInputTokensRatio": {
					"type": "number",
					"default": 1.0,
					"minimum": 0.1,
					"maximum": 1.0,
					"description": "%config.maxInputTokensRatio.desc%"
				},
				"any2copilot.modelPresets": {
					"type": "array",
					"default": [
						{
							"id": "precise",
							"label": "Precise",
							"temperature": 0
						},
						{
							"id": "balanced",
							"label": "Balanced",
							"temperature": 1
						},
						{
							"id": "creative",
							"label": "Creative",
							"temperature": 1.2
						},
						{
							"id": "extra-creative",
							"label": "Extra Creative",
							"temperature": 1.7
						}
					],
					"items": {
						"type": "object",
						"required": [
							"id",
							"label",
							"temperature"
						],
						"properties": {
							"id": {
								"type": "string",
								"description": "%config.modelPreset.id.desc%"
							},
							"label": {
								"type": "string",
								"description": "%config.modelPreset.label.desc%"
							},
							"temperature": {
								"type": "number",
								"description": "%config.modelPreset.temperature.desc%"
							},
							"top_p": {
								"type": "number",
								"description": "%config.modelPreset.top_p.desc%"
							}
						}
					},
					"description": "%config.modelPresets.desc%"
				},
				"any2copilot.visionProxyModel": {
					"type": "string",
					"default": "example-model",
					"description": "%config.visionProxyModel.desc%"
				},
				"any2copilot.visionProxyThinking": {
					"type": "boolean",
					"default": false,
					"description": "%config.visionProxyThinking.desc%"
				},
				"any2copilot.enableThirdPartyTokenIndicator": {
					"type": "boolean",
					"default": false,
					"description": "%config.enableThirdPartyTokenIndicator.desc%"
				},
				"any2copilot.apiMode": {
					"type": "string",
					"default": "auto",
					"enum": ["auto", "openai", "anthropic", "responses"],
					"enumDescriptions": [
						"%config.apiMode.enum.auto.desc%",
						"%config.apiMode.enum.openai.desc%",
						"%config.apiMode.enum.anthropic.desc%",
						"%config.apiMode.enum.responses.desc%"
					],
					"description": "%config.apiMode.desc%"
				},
				"any2copilot.enableResponsesApi": {
					"type": "boolean",
					"default": false,
					"description": "%config.enableResponsesApi.desc%"
				},
				"any2copilot.enableAnthropicApi": {
					"type": "boolean",
					"default": false,
					"description": "%config.enableAnthropicApi.desc%"
				},
				"any2copilot.apiKeyMode": {
					"type": "string",
					"enum": ["sticky", "rotation", "single"],
					"default": "sticky",
					"enumDescriptions": [
						"%config.apiKeyMode.enum.sticky.desc%",
						"%config.apiKeyMode.enum.rotation.desc%",
						"%config.apiKeyMode.enum.single.desc%"
					],
					"description": "%config.apiKeyMode.desc%"
				},
				"any2copilot.singleKeyFallback": {
					"type": "string",
					"enum": ["error", "switch"],
					"default": "switch",
					"enumDescriptions": [
						"%config.singleKeyFallback.enum.error.desc%",
						"%config.singleKeyFallback.enum.switch.desc%"
					],
					"description": "%config.singleKeyFallback.desc%"
				},
				"any2copilot.apiKeyRotationStatusCodes": {
					"type": "array",
					"items": {
						"type": "number"
					},
					"default": [401, 402, 429, 503],
					"description": "%config.apiKeyRotationStatusCodes.desc%"
				},
				"any2copilot.apiKeyRotationErrorPatterns": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": ["余额不足", "insufficient balance", "INSUFFICIENT_BALANCE", "balance", "RATE_LIMITED", "UPSTREAM_RATE_LIMITED"],
					"description": "%config.apiKeyRotationErrorPatterns.desc%"
				},
				"any2copilot.transientRetryStatusCodes": {
					"type": "array",
					"items": {
						"type": "number"
					},
					"default": [429, 500, 503],
					"description": "%config.transientRetryStatusCodes.desc%"
				},
				"any2copilot.apiKeyExhaustedCooldownMin": {
					"type": "number",
					"default": 10,
					"minimum": 0,
					"description": "%config.apiKeyExhaustedCooldownMin.desc%"
				},
				"any2copilot.transientRetryTimes": {
					"type": "number",
					"default": 3,
					"minimum": 0,
					"maximum": 10,
					"description": "%config.transientRetryTimes.desc%"
				},
				"any2copilot.cloudSyncAutoPull": {
					"type": "boolean",
					"default": true,
					"description": "%config.cloudSyncAutoPull.desc%"
				},
				"any2copilot.showUsageInStatusBar": {
					"type": "boolean",
					"default": true,
					"description": "%config.showUsageInStatusBar.desc%"
				},
				"any2copilot.showUsageInTooltip": {
					"type": "boolean",
					"default": true,
					"description": "%config.showUsageInTooltip.desc%"
				},
				"any2copilot.usageRefreshInterval": {
					"type": "number",
					"default": 5,
					"minimum": 1,
					"maximum": 60,
					"description": "%config.usageRefreshInterval.desc%"
				},
				"any2copilot.minBalanceCny": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"description": "%config.minBalanceCny.desc%"
				},
				"any2copilot.balanceCheckIntervalSec": {
					"type": "number",
					"default": 60,
					"minimum": 0,
					"description": "%config.balanceCheckIntervalSec.desc%"
				},
				"any2copilot.delay": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"description": "%config.delay.desc%"
				},
				"any2copilot.readFileLines": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"description": "%config.readFileLines.desc%"
				},
				"any2copilot.visionMaxRounds": {
					"type": "number",
					"default": 5,
					"minimum": 1,
					"maximum": 20,
					"description": "%config.visionMaxRounds.desc%"
				},
				"any2copilot.retry.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%config.retry.enabled.desc%"
				},
				"any2copilot.retry.maxAttempts": {
					"type": "number",
					"default": 2,
					"minimum": 1,
					"maximum": 10,
					"description": "%config.retry.maxAttempts.desc%"
				},
				"any2copilot.retry.intervalMs": {
					"type": "number",
					"default": 1000,
					"minimum": 0,
					"description": "%config.retry.intervalMs.desc%"
				},
				"any2copilot.retry.statusCodes": {
					"type": "array",
					"items": {
						"type": "number"
					},
					"default": [],
					"description": "%config.retry.statusCodes.desc%"
				}
			}
		}
	},
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"clean": "node scripts/build/clean.mjs",
		"compile": "node scripts/build/clean.mjs && tsc -p ./ && node scripts/build/build-info.mjs && node scripts/dev/check-settings.mjs",
		"audit": "node scripts/dev/audit-all.mjs",
		"port": "node scripts/dev/port.mjs",
		"lint": "eslint",
		"watch": "tsc -watch -p ./",
		"test": "npm run compile && npm run test:offline",
		"test:offline": "node test/test-plan-usage.mjs && node test/test-transient-retry.mjs && node test/test-vision-history.mjs && node test/test-anthropic-tool-result-merge.mjs && node test/test-batch-import.mjs",
		"build": "node scripts/build/package-vsix.mjs",
		"postinstall": "node scripts/build/copy-tokenizer.js"
	},
	"dependencies": {
		"@microsoft/tiktokenizer": "^1.0.10"
	},
	"devDependencies": {
		"@eslint/js": "9.39.4",
		"@types/node": "^22",
		"@types/vscode": "^1.116.0",
		"eslint": "9.39.4",
		"typescript": "^5.9.2",
		"typescript-eslint": "8.60.1"
	}
}
